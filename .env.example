# ==============================================================================
# TEG-GATEWAY Environment Configuration
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
SECRET_KEY=teg-gateway-insecure-secret-key-change-in-prod

# InfluxDB v2 Settings
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=secure_token
INFLUXDB_ORG=UCV
INFLUXDB_BUCKET=lora_table

# Gateway C Binaries Directory (Absolute or relative to project root)
GATEWAY_BIN_DIR=/home/pi/gateway

# SQLite Database File Path (Relative to webapp/ or absolute)
DATABASE_PATH=gateway.db

# Timezone Configuration
TIMEZONE=America/Caracas

# Logging
LOG_LEVEL=INFO
